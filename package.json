{
  "name": "aqua-extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode chrome",
    "build": "npm run build:chrome && npm run build:edge && npm run build:firefox && npm run build:brave && npm run build:opera && npm run build:vivaldi && npm run build:safari-source",
    "build:chrome": "vite build --mode chrome",
    "build:edge": "vite build --mode edge",
    "build:firefox": "vite build --mode firefox",
    "build:brave": "vite build --mode brave",
    "build:opera": "vite build --mode opera",
    "build:vivaldi": "vite build --mode vivaldi",
    "build:safari-source": "vite build --mode safari-source",
    "package:safari": "npm run build:safari-source && powershell -ExecutionPolicy Bypass -File scripts/package-safari.ps1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/chrome": "^0.0.320",
    "@types/node": "^26.6.3",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
